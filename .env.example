# Copy to .env (start_local.sh does this for you). Never commit .env or .secrets/.
DEMO_REPO=                 # owner/repo of YOUR public sandbox repo (the only repo the agent may touch)
DEMO_RUN_ID=               # filled in by `./start_local.sh seed`
LLM_BACKEND=ollama         # ollama | scripted (scripted = no model, solves the demo failure only)
MODEL=qwen2.5-coder:7b     # any Ollama model that follows JSON instructions; qwen2.5-coder:3b is faster, weaker
APPROVAL_TTL_S=86400       # how long a PR may wait for a human before it is closed
CODEC_KEY=                 # Fernet key that encrypts Temporal payloads (generated for you)
# The GitHub token lives in .secrets/github_token (a Docker secret), not here.
